{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schema@latest/tauri-conf.schema.json",
  "productName": "HAnimeManager",
  "version": "2.0.0",
  "identifier": "com.hanime.manager",
  "build": {
    "frontendDist": "../frontend-vue/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm --prefix ../frontend-vue run dev",
    "beforeBuildCommand": "npm --prefix ../frontend-vue run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "本地里番管理器",
        "width": 1360,
        "height": 900,
        "resizable": true,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "icon": ["icons/icon.png"],
    "resources": ["lib/**/*"]
  }
}
